    {
      "key": "middle_name",
      "label": "Middle name",
      "type": "text",
      "field": "App Middle",
      "from": "applicant.middle_name"
    },
    {
      "key": "date_of_birth",
      "label": "Date of birth",
      "type": "date",
      "from": "applicant.date_of_birth",
      "required": true,
      "parts": [
        {
          "field": "App DOB MM",
          "part": "month"
        },
        {
          "field": "App DOB DD",
          "part": "day"
        },
        {
          "field": "App DOB YYYY",
          "part": "year"
        }
      ]
    },
    {
      "key": "sex",
      "label": "Sex",
      "type": "choice",
      "field": "Gender",
      "options": {
        "Male": {
          "on": "M"
        },
        "Female": {
          "on": "F"
        }
      },
      "from": "applicant.gender"
    },
    {
      "key": "place_of_birth",
      "label": "Place of birth",
      "type": "text",
      "field": "App Place of Birth",
      "from": "applicant.place_of_birth"
    },
    {
      "key": "ssn",
      "label": "Social Security Number",
      "type": "split",
      "from": "applicant.ssn",
      "required": true,
      "parts": [
        {
          "field": "App SSN 1",
          "take": 3
        },
        {
          "field": "App SSN 2",
          "take": 2
        },
        {
          "field": "App SSN 3",
          "take": 4
        }
      ]
    },
    {
      "key": "email",
      "label": "Email",
      "type": "text",
      "field": "App Email",
      "from": "applicant.email"
    },
    {
      "key": "phone",
      "label": "Phone",
      "type": "split",
      "from": "applicant.phone_home",
      "parts": [
        {
          "field": "App Phone 1",
          "take": 3
        },
        {
          "field": "App Phone 2",
          "take": 3
        },
        {
          "field": "App Phone 3",
          "take": 4
        }
      ]
    },
    {
      "key": "address_street",
